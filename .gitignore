# Using cat with a here-document is faster than opening an editor
# Everything between the two EOF markers is written to the file
cat > .gitignore << 'EOF'
# ── Generated Output (always recreatable, never commit) ──────────
output/
*.report
*.csv.out

# ── Log files generated by tools (not our test_data logs) ────────
*.log
# Exception: keep our hand-written test logs
!test_data/*.log

# ── OS-generated files ───────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor files ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Shell script artifacts ────────────────────────────────────────
*.tmp
/tmp/
EOF
